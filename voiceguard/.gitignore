.venv/
__pycache__/
*.pyc

# Pretrained weights are vendored by checksum, not committed (70.5 MB).
# See weights/PROVENANCE.md for the source URL and SHA-256.
weights/*.pth
*.pth

# Generated Indic manifests and cached audio
data/indic/
data/cache/

# Pilot audio is reproducible from the manifests: every clip records its generator
# revision, per-clip seed and sha256. 339 MB of wav stays on disk, out of git.
data/pilot_refs/audio/
data/pilot_spoof/*/audio/
generators/*/*.safetensors
generators/*/*.pt
generators/*/*.onnx
.venv-gen/
data/f5_train/audio/
data/f5_long/audio/
data/mixed_f5/*.txt
